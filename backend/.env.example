# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (leave DB_ENGINE=sqlite for zero-config local dev) ---
DB_ENGINE=sqlite
DB_NAME=flickrate
DB_USER=flickrate
DB_PASSWORD=flickrate
DB_HOST=localhost
DB_PORT=5432

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:5173

# --- External Movie APIs ---
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Get a free key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
OMDB_BASE_URL=https://www.omdbapi.com/

# --- AI Assistant (optional) ---
# If set, /api/assistant/ uses the Anthropic API. If empty, a deterministic
# metadata-based fallback is used instead (see apps/assistant/engine.py).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7
